---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Card from "../../components/Card.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { byOrder, labQuickLinks, withBase } from "../../lib/site";
import type { IconName } from "../../lib/icons";

const resources = (await getCollection("resources")).sort(byOrder);
---

<BaseLayout
  title="Resources | Qasim Lab"
  description="Lab wiki and onboarding: checklists, culture, foundational literature, and technical skill tutorials."
>
  <Section>
    <SectionHeading
      eyebrow="Lab Wiki & Handbook"
      title="Resources & Onboarding"
      intro="Open guides for getting started in the lab — onboarding, expectations, foundational reading, and technical skills. Edit the Markdown chapters anytime to grow the wiki."
      showRule
    />
    <div class="grid gap-6 md:grid-cols-2">
      {
        resources.map((entry) => (
          <Card class="group relative h-full overflow-hidden !shadow-md hover:!shadow-lg">
            <span
              class="pointer-events-none absolute inset-x-0 top-0 h-px bg-ink/20 transition-colors duration-150 group-hover:bg-accent/50"
              aria-hidden="true"
            />
            <a href={withBase(`/resources/${entry.id}`)} class="block h-full">
              {entry.data.icon && (
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-ink-soft text-ink transition-colors group-hover:bg-ink/15">
                  <Icon name={entry.data.icon as IconName} size={26} />
                </div>
              )}
              <p class="mb-2 text-xs font-medium uppercase tracking-wider text-ink">
                {entry.data.category}
              </p>
              <h3 class="font-display text-xl font-semibold text-foreground group-hover:text-accent">
                {entry.data.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                {entry.data.summary}
              </p>
              <span class="mt-4 inline-block text-sm font-medium text-accent">
                Read guide &rarr;
              </span>
            </a>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section class="bg-surface">
    <SectionHeading
      eyebrow="Campus & Lab"
      title="Useful portals"
      intro="External Rutgers and lab links that support onboarding, computing, and compliance."
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        labQuickLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-xl border border-border bg-background p-5 shadow-sm transition-all duration-150 hover:shadow-md"
          >
            <h3 class="font-display text-lg font-semibold text-foreground">
              {link.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              {link.description}
            </p>
            <span class="mt-3 inline-block text-sm font-medium text-accent">
              Open link &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </Section>
</BaseLayout>
